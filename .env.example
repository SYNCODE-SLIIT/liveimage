# Supabase → Project Settings → Database → Connection string
# Pooled connection (port 6543) used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by Prisma migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Booking email notifications (https://resend.com → API Keys). Optional: bookings still save without them.
RESEND_API_KEY=""
BOOKING_NOTIFY_EMAIL="hello@liveimage.lk"
# Until liveimage.lk is verified in Resend, keep the default test sender
BOOKING_FROM_EMAIL="LIVE IMAGE <onboarding@resend.dev>"

# Auth.js: generate with `openssl rand -base64 32`. NEXTAUTH_URL is the site's public URL.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Supabase Storage for photo uploads. The secret key stays on the server only.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY=""
